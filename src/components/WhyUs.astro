---
import { WHY_US } from '../data/site';
---

<section
  id="why-us"
  class="scroll-mt-20 bg-gradient-to-b from-white to-brand-50/60 py-20 sm:py-24"
  aria-labelledby="why-us-heading"
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold uppercase tracking-widest text-brand-600">我們的理念</p>
      <h2
        id="why-us-heading"
        class="mt-3 text-3xl font-bold tracking-tight text-ink-900 sm:text-4xl"
      >
        為甚麼病人選擇信任我們
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-ink-500">
        牙科治療關乎健康，也關乎信任。這四個承諾，是我們每天堅持的標準。
      </p>
    </div>

    <div class="mt-14 grid gap-5 sm:grid-cols-2">
      {
        WHY_US.map((point, index) => (
          <article class="flex gap-5 rounded-[var(--radius-card)] border border-brand-100/70 bg-white p-7 shadow-soft">
            <span
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-brand-600 text-base font-bold text-white"
              aria-hidden="true"
            >
              {String(index + 1).padStart(2, '0')}
            </span>
            <div>
              <h3 class="text-lg font-bold text-ink-900">{point.title}</h3>
              <p class="mt-2 leading-relaxed text-ink-500">{point.description}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
