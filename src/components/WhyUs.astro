---
import type { Locale } from '../i18n/config';
import { useTranslations } from '../i18n/translations';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section
  id="why-us"
  class="scroll-mt-20 bg-gradient-to-b from-white to-brand-50/60 py-20 sm:py-24"
  aria-labelledby="why-us-heading"
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold uppercase tracking-widest text-brand-600">{t.whyUs.eyebrow}</p>
      <h2
        id="why-us-heading"
        class="mt-3 text-3xl font-bold tracking-tight text-ink-900 sm:text-4xl"
      >
        {t.whyUs.title}
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-ink-500">{t.whyUs.body}</p>
    </div>

    <div class="mt-12 grid gap-5 sm:grid-cols-2">
      <figure class="overflow-hidden rounded-[var(--radius-card)] shadow-soft">
        <img
          src="/images/clinic/waiting-area.jpg"
          alt={t.whyUs.waitingAlt}
          width="960"
          height="640"
          loading="lazy"
          decoding="async"
          class="aspect-[3/2] h-full w-full object-cover"
        />
        <figcaption class="sr-only">{t.whyUs.waitingCaption}</figcaption>
      </figure>
      <figure class="overflow-hidden rounded-[var(--radius-card)] shadow-soft">
        <img
          src="/images/clinic/consultation.jpg"
          alt={t.whyUs.consultAlt}
          width="960"
          height="640"
          loading="lazy"
          decoding="async"
          class="aspect-[3/2] h-full w-full object-cover"
        />
        <figcaption class="sr-only">{t.whyUs.consultCaption}</figcaption>
      </figure>
    </div>

    <div class="mt-8 grid gap-5 sm:grid-cols-2">
      {
        t.whyUs.items.map((point, index) => (
          <article class="flex gap-5 rounded-[var(--radius-card)] border border-brand-100/70 bg-white p-7 shadow-soft">
            <span
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-brand-600 text-base font-bold text-white"
              aria-hidden="true"
            >
              {String(index + 1).padStart(2, '0')}
            </span>
            <div>
              <h3 class="text-lg font-bold text-ink-900">{point.title}</h3>
              <p class="mt-2 leading-relaxed text-ink-500">{point.description}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
