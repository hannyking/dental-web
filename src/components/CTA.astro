---
import type { Locale } from '../i18n/config';
import { getWhatsAppUrl, useTranslations } from '../i18n/translations';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const whatsapp = getWhatsAppUrl(locale);
---

<section class="relative overflow-hidden py-20 sm:py-24" aria-labelledby="cta-heading">
  <div class="absolute inset-0" aria-hidden="true">
    <img
      src="/images/cta/tech-bg.jpg"
      alt=""
      width="1920"
      height="1080"
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover object-center"
    />
    <div class="absolute inset-0 bg-ink-900/70"></div>
    <div class="absolute inset-0 bg-gradient-to-br from-brand-900/50 via-transparent to-brand-700/40"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-3xl px-4 text-center sm:px-6">
    <h2 id="cta-heading" class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
      {t.banner.title}
    </h2>
    <p class="mx-auto mt-4 max-w-xl text-lg leading-relaxed text-white/80">{t.banner.body}</p>
    <a
      href={whatsapp}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-8 inline-flex items-center gap-2.5 rounded-full bg-white px-8 py-4 text-base font-bold text-brand-700 shadow-lift transition-all hover:-translate-y-0.5 hover:bg-brand-50"
    >
      <Icon name="whatsapp" class="h-5 w-5" />
      {t.cta.whatsappNow}
    </a>
    <p class="mt-5 text-sm text-white/55">{t.banner.note}</p>
  </div>
</section>
