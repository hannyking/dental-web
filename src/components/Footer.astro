---
import { LOCATIONS, NAV_ITEMS, WHATSAPP_URL } from '../data/site';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
---

<footer class="bg-ink-900 text-cream-100" aria-labelledby="footer-heading">
  <h2 id="footer-heading" class="sr-only">頁尾資訊</h2>
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-4">
      <!-- Brand -->
      <div class="lg:col-span-1">
        <div class="flex items-center gap-2.5">
          <span
            class="flex h-10 w-10 items-center justify-center rounded-xl bg-white/10 text-brand-200"
            aria-hidden="true"
          >
            <svg viewBox="0 0 24 24" class="h-5.5 w-5.5" fill="currentColor">
              <path
                d="M12 2C8.5 2 6 4.2 6 7.2c0 4.4 2.2 5.5 2.2 9.3 0 2.7 1.3 5.5 3.8 5.5s3.8-2.8 3.8-5.5c0-3.8 2.2-4.9 2.2-9.3C18 4.2 15.5 2 12 2z"
              ></path>
            </svg>
          </span>
          <span class="leading-tight">
            <span class="block text-[15px] font-bold tracking-wide text-white">Apex Oral Care</span>
            <span class="block text-xs font-medium text-brand-300">卓峰口腔護理</span>
          </span>
        </div>
        <p class="mt-5 text-sm leading-relaxed text-cream-100/70">
          以專業、透明與同理心，守護你和家人的口腔健康。中環及尖沙咀應診。
        </p>
        <a
          href={WHATSAPP_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 inline-flex items-center gap-2 rounded-full bg-white/10 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-white/20"
        >
          <Icon name="whatsapp" class="h-4.5 w-4.5" />
          WhatsApp 預約
        </a>
      </div>

      <!-- Quick links -->
      <nav aria-label="頁尾選單">
        <h3 class="text-sm font-bold uppercase tracking-wider text-brand-300">快速連結</h3>
        <ul class="mt-5 space-y-3">
          {
            NAV_ITEMS.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-sm text-cream-100/70 transition-colors hover:text-white"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Locations -->
      {
        LOCATIONS.map((clinic) => (
          <div>
            <h3 class="text-sm font-bold uppercase tracking-wider text-brand-300">
              {clinic.district}診所
            </h3>
            <address class="mt-5 space-y-3 text-sm not-italic leading-relaxed text-cream-100/70">
              <p class="flex gap-2.5">
                <Icon name="location" class="mt-0.5 h-4 w-4 shrink-0 text-brand-400" />
                {clinic.address}
              </p>
              <p class="flex gap-2.5">
                <Icon name="phone" class="mt-0.5 h-4 w-4 shrink-0 text-brand-400" />
                <a
                  href={`tel:${clinic.phone.replace(/\s/g, '')}`}
                  class="transition-colors hover:text-white"
                >
                  {clinic.phone}
                </a>
              </p>
              <p class="flex gap-2.5">
                <Icon name="clock" class="mt-0.5 h-4 w-4 shrink-0 text-brand-400" />
                <span>
                  星期一至五 10:00–19:30
                  <br />
                  星期六 09:30–17:00
                </span>
              </p>
            </address>
          </div>
        ))
      }
    </div>

    <div
      class="mt-14 flex flex-col items-center justify-between gap-4 border-t border-white/10 pt-8 text-xs text-cream-100/50 sm:flex-row"
    >
      <p>© {year} Apex Oral Care 卓峰口腔護理。版權所有。</p>
      <p>本網站資訊僅供參考，不能取代專業牙醫診斷。</p>
    </div>
  </div>
</footer>
