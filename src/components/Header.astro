---
import type { Locale } from '../i18n/config';
import { getLocalePath } from '../i18n/config';
import { getWhatsAppUrl, useTranslations } from '../i18n/translations';
import Icon from './Icon.astro';
import LangSwitcher from './LangSwitcher.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const whatsapp = getWhatsAppUrl(locale);
const homeHref = getLocalePath(locale);
---

<header
  id="site-header"
  class="sticky top-0 z-50 bg-cream-50/85 backdrop-blur-md border-b border-brand-100/60 transition-shadow duration-300"
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="flex h-16 items-center justify-between gap-3">
      <a href={homeHref} class="flex items-center gap-2.5 shrink-0" aria-label={t.a11y.home}>
        <span
          class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-brand-500 to-brand-700 text-white shadow-soft"
          aria-hidden="true"
        >
          <svg viewBox="0 0 24 24" class="h-5.5 w-5.5" fill="currentColor">
            <path
              d="M12 2C8.5 2 6 4.2 6 7.2c0 4.4 2.2 5.5 2.2 9.3 0 2.7 1.3 5.5 3.8 5.5s3.8-2.8 3.8-5.5c0-3.8 2.2-4.9 2.2-9.3C18 4.2 15.5 2 12 2z"
            />
          </svg>
        </span>
        <span class="leading-tight">
          <span class="block text-[15px] font-bold tracking-wide text-ink-900">Apex Oral Care</span>
          <span class="block text-xs font-medium text-brand-700">{t.brand.nameZh}</span>
        </span>
      </a>

      <nav aria-label={t.a11y.mainNav} class="hidden lg:block">
        <ul class="flex items-center gap-1">
          {
            t.nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="rounded-lg px-3.5 py-2 text-[15px] font-medium text-ink-700 transition-colors hover:bg-brand-50 hover:text-brand-700"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex items-center gap-2">
        <LangSwitcher locale={locale} />

        <a
          href={whatsapp}
          target="_blank"
          rel="noopener noreferrer"
          class="hidden sm:inline-flex items-center gap-2 rounded-full bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white shadow-soft transition-all hover:bg-brand-700 hover:shadow-lift"
        >
          <Icon name="whatsapp" class="h-4 w-4" />
          {t.cta.whatsapp}
        </a>

        <button
          id="menu-toggle"
          type="button"
          class="inline-flex h-10 w-10 items-center justify-center rounded-lg text-ink-700 transition-colors hover:bg-brand-50 lg:hidden"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label={t.a11y.openMenu}
          data-label-open={t.a11y.openMenu}
          data-label-close={t.a11y.closeMenu}
        >
          <span id="menu-icon-open"><Icon name="menu" class="h-6 w-6" /></span>
          <span id="menu-icon-close" class="hidden"><Icon name="close" class="h-6 w-6" /></span>
        </button>
      </div>
    </div>
  </div>

  <nav id="mobile-menu" aria-label={t.a11y.mobileNav} class="hidden border-t border-brand-100/60 bg-cream-50 lg:hidden">
    <ul class="mx-auto max-w-6xl space-y-1 px-4 py-4 sm:px-6">
      {
        t.nav.map((item) => (
          <li>
            <a
              href={item.href}
              class="mobile-nav-link block rounded-lg px-4 py-3 text-base font-medium text-ink-700 transition-colors hover:bg-brand-50 hover:text-brand-700"
            >
              {item.label}
            </a>
          </li>
        ))
      }
      <li class="pt-2">
        <a
          href={whatsapp}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center gap-2 rounded-full bg-brand-600 px-5 py-3 text-base font-semibold text-white shadow-soft"
        >
          <Icon name="whatsapp" class="h-5 w-5" />
          {t.cta.whatsapp}
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');
  const header = document.getElementById('site-header');
  const openLabel = toggle?.getAttribute('data-label-open') ?? 'Open menu';
  const closeLabel = toggle?.getAttribute('data-label-close') ?? 'Close menu';

  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
    toggle.setAttribute('aria-label', expanded ? openLabel : closeLabel);
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
      toggle?.setAttribute('aria-label', openLabel);
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    });
  });

  const onScroll = () => {
    if (window.scrollY > 8) header?.classList.add('shadow-soft');
    else header?.classList.remove('shadow-soft');
  };
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
