---
import type { Locale } from '../i18n/config';
import { getServices, getWhatsAppUrl, useTranslations } from '../i18n/translations';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const services = getServices(locale);
const whatsapp = getWhatsAppUrl(locale);
---

<section id="services" class="scroll-mt-20 py-20 sm:py-24" aria-labelledby="services-heading">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold uppercase tracking-widest text-brand-600">{t.services.eyebrow}</p>
      <h2
        id="services-heading"
        class="mt-3 text-3xl font-bold tracking-tight text-ink-900 sm:text-4xl"
      >
        {t.services.title}
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-ink-500">{t.services.body}</p>
    </div>

    <ul class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-4" role="list">
      {
        services.map((service) => (
          <li class="group overflow-hidden rounded-[var(--radius-card)] border border-brand-100/70 bg-white shadow-soft transition-all duration-300 hover:-translate-y-1 hover:border-brand-200 hover:shadow-lift">
            <div class="relative aspect-[4/3] overflow-hidden bg-brand-50">
              <img
                src={service.image}
                alt={service.title}
                width="640"
                height="480"
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
            </div>
            <div class="p-6">
              <div
                class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand-50 text-brand-600 transition-colors group-hover:bg-brand-100"
                aria-hidden="true"
              >
                <Icon name={service.icon} class="h-5 w-5" />
              </div>
              <h3 class="mt-4 text-lg font-bold text-ink-900">{service.title}</h3>
              <p class="mt-2.5 text-[15px] leading-relaxed text-ink-500">{service.description}</p>
            </div>
          </li>
        ))
      }
    </ul>

    <div class="mt-12 text-center">
      <p class="text-ink-500">{t.services.unsure}</p>
      <a
        href={whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-3 inline-flex items-center gap-2 font-semibold text-brand-600 underline decoration-brand-300 decoration-2 underline-offset-4 transition-colors hover:text-brand-700 hover:decoration-brand-500"
      >
        <Icon name="whatsapp" class="h-4.5 w-4.5" />
        {t.cta.whatsappAsk}
      </a>
    </div>
  </div>
</section>
