---
import type { Locale } from '../i18n/config';
import { getWhatsAppUrl, useTranslations } from '../i18n/translations';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const whatsapp = getWhatsAppUrl(locale);
---

<section id="faq" class="scroll-mt-20 py-20 sm:py-24" aria-labelledby="faq-heading">
  <div class="mx-auto max-w-3xl px-4 sm:px-6">
    <div class="text-center">
      <p class="text-sm font-semibold uppercase tracking-widest text-brand-600">{t.faq.eyebrow}</p>
      <h2
        id="faq-heading"
        class="mt-3 text-3xl font-bold tracking-tight text-ink-900 sm:text-4xl"
      >
        {t.faq.title}
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-ink-500">{t.faq.body}</p>
    </div>

    <div class="mt-12 space-y-3">
      {
        t.faq.items.map((faq, index) => (
          <details
            class="group rounded-2xl border border-brand-100/70 bg-white shadow-soft transition-colors open:border-brand-200"
            name="faq"
          >
            <summary
              class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-5 text-left text-base font-semibold text-ink-900 transition-colors hover:text-brand-700 [&::-webkit-details-marker]:hidden"
              id={`faq-q-${index}`}
            >
              {faq.question}
              <span
                class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-50 text-brand-600 transition-transform duration-300 group-open:rotate-180"
                aria-hidden="true"
              >
                <Icon name="chevron" class="h-4 w-4" />
              </span>
            </summary>
            <div class="px-6 pb-6 leading-relaxed text-ink-500" role="region" aria-labelledby={`faq-q-${index}`}>
              {faq.answer}
            </div>
          </details>
        ))
      }
    </div>

    <div class="mt-10 text-center">
      <a
        href={whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-full bg-brand-600 px-7 py-3.5 text-base font-semibold text-white shadow-lift transition-all hover:-translate-y-0.5 hover:bg-brand-700"
      >
        <Icon name="whatsapp" class="h-5 w-5" />
        {t.cta.whatsappFaq}
      </a>
    </div>
  </div>
</section>
