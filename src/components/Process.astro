---
import type { Locale } from '../i18n/config';
import { useTranslations } from '../i18n/translations';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const steps = t.process.steps;
---

<section id="process" class="scroll-mt-20 py-20 sm:py-24" aria-labelledby="process-heading">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold uppercase tracking-widest text-brand-600">{t.process.eyebrow}</p>
      <h2
        id="process-heading"
        class="mt-3 text-3xl font-bold tracking-tight text-ink-900 sm:text-4xl"
      >
        {t.process.title}
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-ink-500">{t.process.body}</p>
    </div>

    <ol class="relative mt-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6">
      {
        steps.map((item, index) => (
          <li class="relative">
            {index < steps.length - 1 && (
              <div
                class="absolute left-[calc(50%+2.5rem)] top-8 hidden h-px w-[calc(100%-5rem)] bg-gradient-to-r from-brand-300 to-brand-200 lg:block"
                aria-hidden="true"
              />
            )}
            <div class="flex flex-col items-center text-center">
              <div
                class="relative z-10 flex h-16 w-16 items-center justify-center rounded-2xl border border-brand-200 bg-white text-lg font-bold text-brand-600 shadow-soft"
                aria-hidden="true"
              >
                {item.step}
              </div>
              <h3 class="mt-5 text-lg font-bold text-ink-900">{item.title}</h3>
              <p class="mt-2 max-w-xs text-[15px] leading-relaxed text-ink-500">
                {item.description}
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
