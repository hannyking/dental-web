---
import type { Locale } from '../i18n/config';
import { getLocations, getWhatsAppUrl, useTranslations } from '../i18n/translations';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const locations = getLocations(locale);
const whatsapp = getWhatsAppUrl(locale);
---

<section
  id="locations"
  class="scroll-mt-20 bg-gradient-to-b from-brand-50/60 to-white py-20 sm:py-24"
  aria-labelledby="locations-heading"
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold uppercase tracking-widest text-brand-600">{t.locations.eyebrow}</p>
      <h2
        id="locations-heading"
        class="mt-3 text-3xl font-bold tracking-tight text-ink-900 sm:text-4xl"
      >
        {t.locations.title}
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-ink-500">{t.locations.body}</p>
    </div>

    <div class="mt-14 grid gap-6 md:grid-cols-2">
      {
        locations.map((clinic) => (
          <article class="overflow-hidden rounded-[var(--radius-card)] border border-brand-100/70 bg-white shadow-soft">
            <div class="flex items-center gap-3 bg-gradient-to-r from-brand-600 to-brand-500 px-7 py-5">
              <Icon name="location" class="h-5 w-5 text-white/90" />
              <div>
                <p class="text-xs font-medium uppercase tracking-wider text-brand-100">
                  {clinic.district}
                </p>
                <h3 class="text-lg font-bold text-white">{clinic.name}</h3>
              </div>
            </div>
            <div class="space-y-5 px-7 py-6">
              <div class="flex gap-3">
                <Icon name="location" class="mt-0.5 h-5 w-5 shrink-0 text-brand-500" />
                <p class="leading-relaxed text-ink-700">{clinic.address}</p>
              </div>
              <div class="flex gap-3">
                <Icon name="clock" class="mt-0.5 h-5 w-5 shrink-0 text-brand-500" />
                <ul class="space-y-1 text-[15px] leading-relaxed text-ink-700">
                  {clinic.hours.map((line) => (
                    <li>{line}</li>
                  ))}
                </ul>
              </div>
              <div class="flex gap-3">
                <Icon name="phone" class="mt-0.5 h-5 w-5 shrink-0 text-brand-500" />
                <a
                  href={`tel:${clinic.phone.replace(/\s/g, '')}`}
                  class="font-medium text-brand-700 underline decoration-brand-300 underline-offset-4 transition-colors hover:text-brand-800"
                >
                  {clinic.phone}
                </a>
              </div>
              <a
                href={whatsapp}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-2 inline-flex w-full items-center justify-center gap-2 rounded-full bg-brand-50 px-5 py-3 text-sm font-semibold text-brand-700 transition-colors hover:bg-brand-100"
              >
                <Icon name="whatsapp" class="h-4.5 w-4.5" />
                {t.cta.bookClinic(clinic.district)}
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
